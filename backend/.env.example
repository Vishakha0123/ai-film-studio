# ---------- App ----------
APP_ENV=development
CORS_ORIGINS=["http://localhost:5173"]
PUBLIC_BASE_URL=http://localhost:8000

# ---------- Database: Supabase Postgres ----------
# Supabase → Project Settings → Database → Connection string (URI). Use the session pooler (port 5432).
# Leave as SQLite to try things locally without Supabase.
DATABASE_URL=sqlite:///./cineai.db
# DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# ---------- Auth: Supabase ----------
# "supabase" verifies Supabase access tokens. "dev" accepts `Bearer dev:<email>` — local only, never in production.
AUTH_MODE=supabase
SUPABASE_URL=https://<project-ref>.supabase.co
# Only if your project still uses the legacy HS256 JWT secret (Settings → API → JWT Settings):
SUPABASE_JWT_SECRET=
# Server-side only, for Storage uploads. NEVER put this in the frontend.
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Storage ----------
# local = ./media served by this API; supabase = public bucket below
STORAGE_BACKEND=local
SUPABASE_STORAGE_BUCKET=assets

# ---------- Jobs ----------
# Empty = run jobs inside the API process. Set to use the Arq worker (arq app.workers.arq_worker.WorkerSettings).
REDIS_URL=

# ---------- AI providers ("mock" needs no keys) ----------
STORY_PROVIDER=mock      # mock | sarvam
IMAGE_PROVIDER=mock      # mock | openai
VIDEO_PROVIDER=mock      # mock | seedance
TTS_PROVIDER=mock        # mock | sarvam

SARVAM_API_KEY=
SARVAM_CHAT_MODEL=sarvam-105b
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=shubh

OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1

ATLAS_API_KEY=
# Copy the exact Seedance image-to-video model id from the Atlas Cloud console
SEEDANCE_MODEL=bytedance/seedance-v1.5-pro/image-to-video

# ---------- Cost gate (USD) ----------
COST_CONFIRM_THRESHOLD=1.00
