# ---------- Backend ----------
# Leave empty for demo mode (sample film, no backend needed).
# Set to the FastAPI backend origin to use the live API:
VITE_API_URL=
# VITE_API_URL=http://localhost:8000

# ---------- Supabase Auth ----------
# Supabase → Project Settings → API. The anon key is public and safe in the browser.
# Leave empty to use dev login (backend AUTH_MODE=dev): the Google and Apple buttons sign in local test users.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Audio, Music and Generate Teaser are "Coming soon" (locked). Set to true to unlock them locally.
VITE_UNLOCK_PREVIEW=
